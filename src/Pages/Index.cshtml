@page
@{ViewData["Title"]="A second life. A new favourite.";ViewData["Page"]="home";}
<section class="fashion-hero"><div class="fashion-hero-copy"><span class="eyebrow">FASHION · LEBANON</span><h1>Found once.<br/><em>Worn your way.</em></h1><p>Pre-loved character. Unexpected details. A wardrobe with a story. Explore Vintage Magic’s archive looks and pop-up photo diary.</p><a href="/shop" class="button">Explore the archive <span>↗</span></a><div class="hero-meta"><span>EXPLORE THE COLLECTION</span><span>A PERSONAL CONVERSATION</span></div></div><div class="fashion-hero-image hero-collage"><img src="@Shop.Settings.Hero" alt="From the Vintage Magic collection" width="640" height="850" fetchpriority="high"/><img src="@Shop.Products.Where(p=>p.Images[0]!=Shop.Settings.Hero).First().Images[0]" alt="Another look from Vintage Magic" width="640" height="850"/><img src="@Shop.Products.Where(p=>p.Images[0]!=Shop.Settings.Hero).Skip(1).First().Images[0]" alt="More inspiration from Vintage Magic" width="640" height="850"/><span class="photo-label">THE VINTAGE MAGIC EDIT</span></div><span class="hero-decoration" aria-hidden="true">✳</span></section>
<div class="values-strip"><span>A second life. A new favourite.</span><i>✦</i><span>Discover · Save · Enquire</span><i>✦</i><a href="/lookbook">A closer look at the collection ↗</a></div>
<div class="n12-running" aria-hidden="true"><div><span>Vintage Magic</span><i>✦</i><span>FASHION · LEBANON</span><i>✦</i><span>Discover · Save · Enquire</span><i>✦</i><span>Made for your own point of view</span><i>✦</i><span>Vintage Magic</span><i>✦</i><span>FASHION · LEBANON</span><i>✦</i><span>Discover · Save · Enquire</span><i>✦</i><span>Made for your own point of view</span><i>✦</i><span>Vintage Magic</span><i>✦</i><span>FASHION · LEBANON</span><i>✦</i><span>Discover · Save · Enquire</span><i>✦</i><span>Made for your own point of view</span><i>✦</i><span>Vintage Magic</span><i>✦</i><span>FASHION · LEBANON</span><i>✦</i><span>Discover · Save · Enquire</span><i>✦</i><span>Made for your own point of view</span><i>✦</i></div></div>
<section class="section first-edit" data-reveal><div class="section-heading"><div><span class="eyebrow">FIND YOUR NEXT FAVOURITE</span><h2>Archive looks.<br/><em>A fresh perspective.</em></h2></div><div><p>Photographed archive inspiration.<br/>Ask about current or similar finds.</p><a href="/shop" class="text-link">Discover the whole edit ↗</a></div></div><div class="product-grid">@foreach(var p in Shop.Products.Take(4)){<partial name="_Card" model="p"/>}</div></section>
<section class="fashion-story" data-reveal><div class="fashion-story-photo"><img src="@Shop.Settings.Story" alt="A closer look at Vintage Magic" width="900" height="1200" loading="lazy"/></div><div class="fashion-story-copy"><span class="eyebrow">THE WORLD OF VINTAGE MAGIC</span><h2>The story.<br/><em>Your own way.</em></h2><p>Vintage Magic is a Lebanese vintage clothing page sharing pre-loved finds and pop-up diaries. Its public biography lists monthly pop-ups and online drops. These archive photographs offer inspiration; ask the shop about current finds and upcoming visiting dates.</p><a href="/our-world" class="button outline">Discover our world <span>↗</span></a><span class="section-number">02 / Vintage Magic</span></div></section>
<section class="section category-edit" data-reveal><div class="section-heading"><div><span class="eyebrow">A LITTLE DIRECTION</span><h2>What are you<br/><em>in the mood for?</em></h2></div><a href="/style-guide" class="text-link">Help me choose ↗</a></div><div class="category-grid">@foreach(var (category,i) in Shop.Products.Select(p=>p.Collection).Distinct().Take(3).Select((x,i)=>(x,i))){var p=Shop.Products.First(p=>p.Collection==category);<a href="/shop?collection=@Uri.EscapeDataString(category)"><div><img src="@p.Images[0]" alt="@category from Vintage Magic" width="700" height="930" loading="lazy"/></div><span>0@(i+1) / @category <b>↗</b></span></a>}</div></section>
<section class="section diary-feature" data-reveal><div><span class="eyebrow">THE VISUAL DIARY</span><h2>A detail.<br/>A different angle.<br/><em>A new favourite.</em></h2><p>Explore the collection in photographs. Follow a colour, discover a silhouette and gather your inspiration.</p><a href="/lookbook" class="button">Open the photo diary <span>↗</span></a></div><div class="diary-pair"><img src="@Shop.Products.Last().Images[0]" alt="Collection inspiration from Vintage Magic" width="720" height="960" loading="lazy"/><img src="@Shop.Products.Skip(1).First().Images.Last()" alt="More collection details from Vintage Magic" width="520" height="690" loading="lazy"/></div></section>
<section class="section shopping-steps" data-reveal><div><span class="eyebrow">MAKE IT PERSONAL</span><h2>From inspiration<br/><em>to a conversation.</em></h2></div><ol><li><span>01</span><h3>Find your favourites</h3><p>Browse the collection, explore the photographs and save the looks that speak to you.</p></li><li><span>02</span><h3>Build your selection</h3><p>Add your pieces to a bag and share your size, colour and delivery questions.</p></li><li><span>03</span><h3>Talk to the team</h3><p>Review your enquiry before sending. The boutique confirms options, availability and the final price.</p></li></ol></section>
